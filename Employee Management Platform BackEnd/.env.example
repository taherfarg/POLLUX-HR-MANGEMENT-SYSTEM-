# ---------------------------------------------------------------------------
# Employee Management Platform - backend environment
# Copy to `.env` and adjust. Every value is validated at boot (src/config/env.ts);
# the process refuses to start on an invalid config rather than failing later.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# The ONLY coupling to a specific database host. Swap this for a hosted
# Postgres URL (Supabase / Neon / Railway / RDS) to deploy - nothing else changes.
DATABASE_URL=postgresql://ems:ems_local_password@localhost:5433/ems?schema=public

# Secrets. MUST be replaced in any deployed environment.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_only_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Password used for every seeded demo account.
SEED_DEMO_PASSWORD=Passw0rd!23

# Optional. Switches on Google Gemini for two things: the HR assistant
# (managers and HR ask questions about attendance, leave, approvals and tasks)
# and AI-drafted HR letters. Get a key at https://aistudio.google.com/apikey
# Leave empty and the assistant stays off and letters use deterministic
# templates - everything else works, so the demo needs no key.
GOOGLE_API_KEY=
# The Gemini model for both. Change it if Google retires this one.
GOOGLE_AI_MODEL=gemini-2.5-flash
# Questions each person may ask the assistant per hour.
AI_ASSISTANT_HOURLY_LIMIT=60

LOG_LEVEL=info
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=300
